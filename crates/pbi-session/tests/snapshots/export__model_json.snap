    {
      "name": "Products Never Sold",
      "description": "Calculated table: catalog products without any order.",
      "kind": "calculatedTable",
      "hidden": false,
      "columns": [
        {
          "name": "Product ID",
          "dataType": "string",
          "kind": "calculatedTableColumn",
          "hidden": false,
          "key": false,
          "sourceColumn": "[Product ID]",
          "summarizeBy": "none"
        },
        {
          "name": "Product",
          "dataType": "string",
          "kind": "calculatedTableColumn",
          "hidden": false,
          "key": false,
          "sourceColumn": "[Product]",
          "summarizeBy": "none"
        },
        {
          "name": "Category",
          "dataType": "string",
          "kind": "calculatedTableColumn",
          "hidden": false,
          "key": false,
          "sourceColumn": "[Category]",
          "summarizeBy": "none"
        },
        {
          "name": "List Price",
          "dataType": "decimal",
          "kind": "calculatedTableColumn",
          "hidden": false,
          "key": false,
          "sourceColumn": "[List Price]",
          "formatString": "\\$#,0.00",
          "summarizeBy": "none"
        }
      ],
      "measures": [
        {
          "name": "Products Never Sold Count",
          "expression": "COUNTROWS('Products Never Sold') + 0",
          "formatString": "0",
          "hidden": false
        }
      ],
      "partitions": [
        {
          "name": "Products Never Sold",
          "kind": "calculated",
          "language": "dax",
          "mode": "import",
          "expression": "VAR SoldProducts =\n    SELECTCOLUMNS(SUMMARIZE(Orders, Orders[Product ID]), \"Product ID\", Orders[Product ID])\nVAR Catalog =\n    SELECTCOLUMNS(ALL(Products), \"Product ID\", Products[Product ID])\nVAR NeverSold = EXCEPT(Catalog, SoldProducts)\nRETURN\n    SELECTCOLUMNS(\n        FILTER(\n            ALL(Products),\n            Products[Product ID] IN NeverSold\n                && ISEMPTY(RELATEDTABLE(Orders))\n        ),\n        \"Product ID\", Products[Product ID],\n        \"Product\", Products[Product Name],\n        \"Category\", Products[Category],\n        \"List Price\", Products[List Price]\n    )"
        }
      ],
      "hierarchies": []
    },
    {
      "name": "Last Refreshed",
      "description": "Single row stamped with the refresh time (UTC). Not used by any expected value.",
      "kind": "regular",
      "hidden": true,
      "columns": [
        {
          "name": "Last Refreshed (UTC)",
          "dataType": "dateTime",
