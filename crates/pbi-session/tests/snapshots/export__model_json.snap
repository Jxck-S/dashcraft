          "kind": "m",
          "language": "m",
          "mode": "import",
          "expression": "let\n    Source = AzureStorage.Blobs(StorageContainerUrl),\n    #\"Source CSV\" = Csv.Document(Source{[Name = \"web/web_sessions.csv\"]}[Content], [Delimiter = \",\", Columns = 6, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),\n    #\"Promoted Headers\" = Table.PromoteHeaders(#\"Source CSV\", [PromoteAllScalars = true]),\n    #\"Cleaned Text\" = Table.TransformColumns(#\"Promoted Headers\", {{\"device\", each Text.Proper(Text.Trim(_)), type text}}),\n    #\"Changed Type\" = Table.TransformColumnTypes(#\"Cleaned Text\", {{\"session_date\", type date}, {\"pages_viewed\", Int64.Type}, {\"converted\", type logical}}),\n    #\"Added Campaign Flag\" = Table.AddColumn(#\"Changed Type\", \"is_campaign\", each Text.Contains([traffic_source], \"Campaign\"), type logical),\n    #\"Renamed Columns\" = Table.RenameColumns(#\"Added Campaign Flag\", {{\"session_id\", \"Session ID\"}, {\"session_date\", \"Session Date\"}, {\"device\", \"Device\"}, {\"traffic_source\", \"Traffic Source\"}, {\"pages_viewed\", \"Pages Viewed\"}, {\"converted\", \"Converted\"}, {\"is_campaign\", \"Is Campaign\"}})\nin\n    #\"Renamed Columns\"",
          "queryGroup": "Sources"
        }
      ],
      "hierarchies": []
    },
    {
      "name": "Date",
      "description": "Calendar 2024-2025, marked as the date table.",
      "kind": "calculatedTable",
      "hidden": false,
      "dataCategory": "Time",
      "columns": [
        {
          "name": "Date",
          "dataType": "dateTime",
          "kind": "calculatedTableColumn",
          "hidden": false,
          "key": true,
          "sourceColumn": "[Date]",
          "formatString": "yyyy-mm-dd",
          "summarizeBy": "none"
        },
        {
          "name": "Year",
          "dataType": "int64",
          "kind": "calculatedTableColumn",
          "hidden": false,
          "key": false,
          "sourceColumn": "[Year]",
          "formatString": "0",
          "summarizeBy": "none"
        },
        {
          "name": "Month Number",
          "dataType": "int64",
          "kind": "calculatedTableColumn",
          "hidden": true,
          "key": false,
          "sourceColumn": "[Month Number]",
          "formatString": "0",
          "summarizeBy": "none"
        },
        {
          "name": "Month",
          "dataType": "string",
          "kind": "calculatedTableColumn",
          "hidden": false,
          "key": false,
          "sourceColumn": "[Month]",
          "sortByColumn": "Month Number",
          "summarizeBy": "none"
        },
        {
          "name": "Year Month",
          "dataType": "string",
          "kind": "calculatedTableColumn",
          "hidden": false,
          "key": false,
          "sourceColumn": "[Year Month]",
          "summarizeBy": "none"
        },
        {
          "name": "Quarter",
          "dataType": "string",
          "kind": "calculatedTableColumn",
          "hidden": false,
          "key": false,
          "sourceColumn": "[Quarter]",
          "summarizeBy": "none"
        },
        {
          "name": "Month Start",
          "dataType": "dateTime",
          "kind": "calculatedTableColumn",
          "hidden": false,
          "key": false,
          "sourceColumn": "[Month Start]",
          "formatString": "yyyy-mm-dd",
          "summarizeBy": "none"
        },
        {
          "name": "Day Type",
          "dataType": "string",
          "kind": "calculated",
          "hidden": false,
          "key": false,
          "expression": "IF(WEEKDAY('Date'[Date], 2) > 5, \"Weekend\", \"Weekday\")",
          "summarizeBy": "none"
        }
      ],
      "measures": [],
      "partitions": [
        {
          "name": "Date",
          "kind": "calculated",
          "language": "dax",
          "mode": "import",
          "expression": "ADDCOLUMNS(\n    CALENDAR(DATE(2024, 1, 1), DATE(2025, 12, 31)),\n    \"Year\", YEAR([Date]),\n    \"Month Number\", MONTH([Date]),\n    \"Month\", FORMAT([Date], \"mmm\"),\n    \"Year Month\", FORMAT([Date], \"yyyy-mm\"),\n    \"Quarter\", \"Q\" & QUARTER([Date]),\n    \"Month Start\", DATE(YEAR([Date]), MONTH([Date]), 1)\n)"
        }
      ],
      "hierarchies": [
        {
          "name": "Calendar",
          "hidden": false,
          "levels": [
            {
              "name": "Year",
              "column": "Year"
            },
            {
              "name": "Quarter",
              "column": "Quarter"
            },
            {
              "name": "Month",
              "column": "Month"
            },
            {
              "name": "Date",
              "column": "Date"
            }
          ]
        }
      ]
    },
