          "sourceColumn": "Last Refreshed (UTC)",
          "formatString": "yyyy-mm-dd hh:nn",
          "summarizeBy": "none"
        }
      ],
      "measures": [],
      "partitions": [
        {
          "name": "Last Refreshed",
          "kind": "m",
          "language": "m",
          "mode": "import",
          "expression": "let\n    Source = #table(type table [#\"Last Refreshed (UTC)\" = datetime], {{DateTimeZone.RemoveZone(DateTimeZone.UtcNow())}})\nin\n    Source",
          "queryGroup": "Sources"
        }
      ],
      "hierarchies": []
    }
