  "parameters": [
    {
      "name": "StorageContainerUrl",
      "type": "Text",
      "required": true,
      "description": "Fictional Azure Blob container with the sample CSVs. Never contacted: DashCraft resolves it\noffline through blob-map.json.",
      "queryGroup": "Parameters",
      "value": "\"https://acmeoutfittersdemo.blob.core.windows.net/sample-data\""
    }
  ],
  "expressions": [
    {
      "name": "fnCleanKey",
      "kind": "m",
      "description": "Trims and upper-cases a business key (customer, store and product ids).",
      "queryGroup": "Functions",
      "expression": "(x as text) as text => Text.Upper(Text.Trim(x))"
    },
    {
      "name": "fnParseNames",
      "kind": "m",
      "description": "Turns a Python-style list of names, such as ['Ana Ruiz', \"O'Neil Park\"], into \"Ana Ruiz; O'Neil Park\".",
      "queryGroup": "Functions",
      "expression": "(raw as text) as text =>\nlet\n    Trimmed = Text.Trim(raw),\n    Inner = if Text.Start(Trimmed, 1) = \"[\" then Text.Range(Trimmed, 1, Text.Length(Trimmed) - 2) else Trimmed,\n    Names = List.Transform(Text.Split(Inner, \",\"), each Text.Trim(Text.Trim(_), {\"'\", \"\"\"\"})),\n    NonEmpty = List.Select(Names, each _ <> \"\"),\n    Result = if List.IsEmpty(NonEmpty) then \"\" else Text.Combine(NonEmpty, \"; \")\nin\n    Result"
    }
  ],
  "roles": [
    {
      "name": "Region West",
      "description": "Sees the West region only: its stores, their orders, returns and targets.",
      "modelPermission": "read",
      "tablePermissions": [
        {
          "table": "Stores",
          "filterExpression": "Stores[Region] = \"West\""
        }
      ]
    },
    {
      "name": "Store Manager",
      "description": "Dynamic security: a manager sees the stores whose Manager Email is the signed-in user.",
      "modelPermission": "read",
      "tablePermissions": [
        {
          "table": "Stores",
          "filterExpression": "Stores[Manager Email] = USERPRINCIPALNAME()"
        }
      ]
    }
  ]
