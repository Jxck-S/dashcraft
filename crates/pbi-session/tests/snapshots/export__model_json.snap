          "kind": "data",
          "hidden": false,
          "key": false,
          "sourceColumn": "Traffic Source",
          "summarizeBy": "none"
        },
        {
          "name": "Pages Viewed",
          "dataType": "int64",
          "kind": "data",
          "hidden": false,
          "key": false,
          "sourceColumn": "Pages Viewed",
          "formatString": "0",
          "summarizeBy": "sum"
        },
        {
          "name": "Converted",
          "dataType": "boolean",
          "kind": "data",
          "hidden": false,
          "key": false,
          "sourceColumn": "Converted",
          "summarizeBy": "none"
        },
        {
          "name": "Is Campaign",
          "dataType": "boolean",
          "kind": "data",
          "hidden": false,
          "key": false,
          "sourceColumn": "Is Campaign",
          "summarizeBy": "none"
        }
      ],
      "measures": [
        {
          "name": "Sessions",
          "expression": "COUNTROWS('Web Sessions')",
          "formatString": "#,0",
          "hidden": false
        },
        {
          "name": "Converted Sessions",
          "expression": "CALCULATE([Sessions], 'Web Sessions'[Converted] = TRUE())",
          "formatString": "#,0",
          "hidden": false
        },
        {
          "name": "Conversion Rate",
          "expression": "DIVIDE([Converted Sessions], [Sessions])",
          "formatString": "0.0%",
          "hidden": false
        },
        {
          "name": "Avg Pages per Session",
          "expression": "AVERAGE('Web Sessions'[Pages Viewed])",
          "formatString": "0.0",
          "hidden": false
        },
        {
          "name": "Sessions (All Devices)",
          "expression": "CALCULATE([Sessions], ALL('Web Sessions'[Device]))",
          "formatString": "#,0",
          "description": "Ignores filters on Device.",
          "hidden": false
        }
      ],
      "partitions": [
        {
