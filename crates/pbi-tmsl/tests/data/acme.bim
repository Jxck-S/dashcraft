          {
            "name": "Web Sessions",
            "mode": "import",
            "queryGroup": "Sources",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = AzureStorage.Blobs(StorageContainerUrl),",
                "    #\"Source CSV\" = Csv.Document(Source{[Name = \"web/web_sessions.csv\"]}[Content], [Delimiter = \",\", Columns = 6, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(#\"Source CSV\", [PromoteAllScalars = true]),",
                "    #\"Cleaned Text\" = Table.TransformColumns(#\"Promoted Headers\", {{\"device\", each Text.Proper(Text.Trim(_)), type text}}),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Cleaned Text\", {{\"session_date\", type date}, {\"pages_viewed\", Int64.Type}, {\"converted\", type logical}}),",
                "    #\"Added Campaign Flag\" = Table.AddColumn(#\"Changed Type\", \"is_campaign\", each Text.Contains([traffic_source], \"Campaign\"), type logical),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Added Campaign Flag\", {{\"session_id\", \"Session ID\"}, {\"session_date\", \"Session Date\"}, {\"device\", \"Device\"}, {\"traffic_source\", \"Traffic Source\"}, {\"pages_viewed\", \"Pages Viewed\"}, {\"converted\", \"Converted\"}, {\"is_campaign\", \"Is Campaign\"}})",
                "in",
                "    #\"Renamed Columns\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Sessions",
            "expression": "COUNTROWS('Web Sessions')",
            "formatString": "#,0",
            "lineageTag": "6a6ed985-e564-5da2-a3b3-b5df68a1a18d"
          },
          {
            "name": "Converted Sessions",
            "expression": "CALCULATE([Sessions], 'Web Sessions'[Converted] = TRUE())",
            "formatString": "#,0",
            "lineageTag": "98b2ec3a-bd20-5556-a6b6-78ef2a1a150a"
          },
          {
            "name": "Conversion Rate",
            "expression": "DIVIDE([Converted Sessions], [Sessions])",
            "formatString": "0.0%",
            "lineageTag": "babff0db-b976-51bc-9cff-488e54755604"
          },
          {
            "name": "Avg Pages per Session",
            "expression": "AVERAGE('Web Sessions'[Pages Viewed])",
            "formatString": "0.0",
            "lineageTag": "c240ed1e-0e13-56c7-95ed-0e688de0384a"
          },
          {
            "name": "Sessions (All Devices)",
            "description": "Ignores filters on Device.",
            "expression": "CALCULATE([Sessions], ALL('Web Sessions'[Device]))",
            "formatString": "#,0",
            "lineageTag": "9f21e8d4-095a-5e32-a3ef-bc81299f3593"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
