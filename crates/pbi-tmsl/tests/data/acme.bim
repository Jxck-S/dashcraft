      {
        "name": "fnCleanKey",
        "description": "Trims and upper-cases a business key (customer, store and product ids).",
        "kind": "m",
        "expression": "(x as text) as text => Text.Upper(Text.Trim(x))",
        "lineageTag": "11ee2aaf-71e5-5390-9523-01f44b7515c1",
        "queryGroup": "Functions",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      },
      {
        "name": "fnParseNames",
        "description": "Turns a Python-style list of names, such as ['Ana Ruiz', \"O'Neil Park\"], into \"Ana Ruiz; O'Neil Park\".",
        "kind": "m",
        "expression": [
          "(raw as text) as text =>",
          "let",
          "    Trimmed = Text.Trim(raw),",
          "    Inner = if Text.Start(Trimmed, 1) = \"[\" then Text.Range(Trimmed, 1, Text.Length(Trimmed) - 2) else Trimmed,",
          "    Names = List.Transform(Text.Split(Inner, \",\"), each Text.Trim(Text.Trim(_), {\"'\", \"\"\"\"})),",
          "    NonEmpty = List.Select(Names, each _ <> \"\"),",
          "    Result = if List.IsEmpty(NonEmpty) then \"\" else Text.Combine(NonEmpty, \"; \")",
          "in",
          "    Result"
        ],
        "lineageTag": "968f9bc3-ca54-5169-a931-fd974c457fe0",
        "queryGroup": "Functions",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      }
    ],
