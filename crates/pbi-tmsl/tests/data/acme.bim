                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "Category",
            "dataType": "string",
            "isNameInferred": true,
            "sourceColumn": "[Category]",
            "lineageTag": "719c1234-eff5-56cb-9cd3-8b0883ca55fb",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "List Price",
            "dataType": "decimal",
            "isNameInferred": true,
            "sourceColumn": "[List Price]",
            "formatString": "\\$#,0.00",
            "lineageTag": "7a0149b5-a73a-5c11-89d0-91052852faad",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Products Never Sold",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "VAR SoldProducts =",
                "    SELECTCOLUMNS(SUMMARIZE(Orders, Orders[Product ID]), \"Product ID\", Orders[Product ID])",
                "VAR Catalog =",
                "    SELECTCOLUMNS(ALL(Products), \"Product ID\", Products[Product ID])",
                "VAR NeverSold = EXCEPT(Catalog, SoldProducts)",
                "RETURN",
                "    SELECTCOLUMNS(",
                "        FILTER(",
                "            ALL(Products),",
                "            Products[Product ID] IN NeverSold",
                "                && ISEMPTY(RELATEDTABLE(Orders))",
                "        ),",
                "        \"Product ID\", Products[Product ID],",
                "        \"Product\", Products[Product Name],",
                "        \"Category\", Products[Category],",
                "        \"List Price\", Products[List Price]",
                "    )"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Products Never Sold Count",
            "expression": "COUNTROWS('Products Never Sold') + 0",
            "formatString": "0",
            "lineageTag": "26a73239-dd82-5fce-ae10-bd74642bb651"
          }
        ]
      },
