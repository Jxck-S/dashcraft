              }
            ]
          },
          {
            "name": "Loyalty Tier",
            "description": "Bronze, Silver, Gold; blanks become Unassigned.",
            "dataType": "string",
            "sourceColumn": "Loyalty Tier",
            "lineageTag": "d35e0961-5fb6-5d93-9b17-0ac369fb5d63",
            "summarizeBy": "none",
