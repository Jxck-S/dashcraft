              }
            ]
          },
          {
            "name": "Account Manager Count",
            "dataType": "int64",
            "sourceColumn": "Account Manager Count",
            "formatString": "0",
            "lineageTag": "bdb5bcdb-3c3d-59dc-8912-5574e5747372",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
