      {
        "name": "Products Never Sold",
        "description": "Calculated table: catalog products without any order.",
        "lineageTag": "d54d7d0e-7269-5501-bd58-7dff0e4fbc6d",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Product ID",
