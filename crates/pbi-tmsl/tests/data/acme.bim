      {
        "name": "Time Calc",
        "description": "Calculation group applied to any measure: Current, YTD, PY and YoY %.",
        "lineageTag": "7c7ed4fa-5512-56bd-8666-2fd606aa8878",
        "calculationGroup": {
          "precedence": 10,
          "calculationItems": [
            {
              "name": "Current",
              "description": "The measure as is.",
              "expression": "SELECTEDMEASURE()",
              "ordinal": 0
            },
            {
              "name": "YTD",
              "description": "Year to date.",
              "expression": "CALCULATE(SELECTEDMEASURE(), DATESYTD('Date'[Date]))",
              "ordinal": 1
            },
            {
              "name": "PY",
              "description": "Same period last year.",
              "expression": "CALCULATE(SELECTEDMEASURE(), SAMEPERIODLASTYEAR('Date'[Date]))",
              "ordinal": 2
            },
            {
              "name": "YoY %",
              "description": "Change against the same period last year, always shown as a percent.",
              "expression": [
                "VAR CurrentValue = SELECTEDMEASURE()",
                "VAR PriorValue = CALCULATE(SELECTEDMEASURE(), SAMEPERIODLASTYEAR('Date'[Date]))",
                "RETURN",
                "    DIVIDE(CurrentValue - PriorValue, PriorValue)"
              ],
              "ordinal": 3,
              "formatStringDefinition": {
                "expression": "\"+0.0%;-0.0%;0.0%\""
              }
            }
          ]
        },
        "columns": [
          {
            "name": "Time Calculation",
            "dataType": "string",
            "sourceColumn": "Name",
            "sortByColumn": "Ordinal",
            "lineageTag": "9b34b232-a947-54e3-9063-c892cd18f5e6",
            "summarizeBy": "none",
            "annotations": [
