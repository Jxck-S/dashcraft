      "signals": [
        "`$schema` https://developer.microsoft.com/json-schemas/fabric/pbip/pbipProperties/1.0.0/schema.json",
        "report `Acme Outfitters - Online.Report` (PBIR; byPath `../AcmeOutfitters.SemanticModel`)",
        "report `Acme Outfitters - Overview.Report` (PBIR; byPath `../AcmeOutfitters.SemanticModel`)",
        "report `Acme Outfitters - Stores.Report` (PBIR; byPath `../AcmeOutfitters.SemanticModel`)",
        "semantic model `AcmeOutfitters.SemanticModel` (TMDL)"
      ]
    }
  },
  "modelStatus": {
    "status": "local"
  },
  "model": {
    "name": "Model",
    "description": "Acme Outfitters: a synthetic outdoor-gear retailer (fictional data, DashCraft example).",
    "culture": "en-US",
    "compatibilityLevel": 1601,
    "source": {
      "kind": "tmdl",
      "folder": "AcmeOutfitters.SemanticModel"
    },
    "tables": [
      {
        "name": "Orders",
        "description": "One row per order line (synthetic). Cleaned in M: rows without an id and duplicates removed, keys trimmed and upper-cased, blank discounts set to 0.",
        "isHidden": false,
        "kind": "regular",
        "columns": [
          {
            "name": "Order ID",
            "dataType": "string",
            "kind": "data",
            "isHidden": false,
            "isKey": true,
            "description": "Order number (SO-…). Unique after Table.Distinct.",
            "sourceColumn": "Order ID",
            "summarizeBy": "none"
          },
          {
            "name": "Order Date",
            "dataType": "dateTime",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "Order Date",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none"
          },
          {
            "name": "Ship Date",
            "dataType": "dateTime",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "description": "Blank for cancelled and pending orders. Inactive relationship to 'Date' (USERELATIONSHIP).",
            "sourceColumn": "Ship Date",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none"
          },
          {
            "name": "Customer ID",
            "dataType": "string",
            "kind": "data",
            "isHidden": true,
            "isKey": false,
            "sourceColumn": "Customer ID",
            "summarizeBy": "none"
          },
          {
            "name": "Store ID",
            "dataType": "string",
            "kind": "data",
            "isHidden": true,
            "isKey": false,
            "sourceColumn": "Store ID",
            "summarizeBy": "none"
          },
          {
            "name": "Product ID",
            "dataType": "string",
            "kind": "data",
            "isHidden": true,
            "isKey": false,
            "sourceColumn": "Product ID",
            "summarizeBy": "none"
          },
          {
            "name": "Quantity",
            "dataType": "int64",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "Quantity",
            "formatString": "0",
            "summarizeBy": "sum"
          },
          {
            "name": "Unit Price",
            "dataType": "double",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "Unit Price",
            "formatString": "\\$#,0.00",
            "summarizeBy": "none"
          },
          {
            "name": "Discount",
            "dataType": "double",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "Discount",
            "formatString": "0%",
            "summarizeBy": "none"
          },
          {
            "name": "Status",
            "dataType": "string",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "description": "Completed, Cancelled or Pending.",
            "sourceColumn": "Status",
            "summarizeBy": "none"
          },
          {
            "name": "Line Amount",
            "dataType": "double",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "description": "Quantity × unit price × (1 − discount), computed in M.",
            "sourceColumn": "Line Amount",
            "formatString": "\\$#,0.00",
            "summarizeBy": "sum"
          },
          {
            "name": "Line Cost",
            "dataType": "double",
            "kind": "calculated",
            "isHidden": false,
            "isKey": false,
            "description": "Blank when the product is not in the catalog.",
            "expression": "Orders[Quantity] * RELATED(Products[Unit Cost])",
            "formatString": "\\$#,0.00",
            "summarizeBy": "sum"
          },
          {
            "name": "Order Size",
            "dataType": "string",
            "kind": "calculated",
            "isHidden": false,
            "isKey": false,
            "expression": "SWITCH(TRUE(), Orders[Line Amount] >= 1000, \"Large\", Orders[Line Amount] >= 250, \"Medium\", \"Small\")",
            "summarizeBy": "none"
          },
          {
            "name": "Is Returned",
            "dataType": "string",
            "kind": "calculated",
            "isHidden": false,
            "isKey": false,
            "description": "Context transition through the one-to-one relationship to Returns.",
            "expression": "IF(ISEMPTY(RELATEDTABLE(Returns)), \"No\", \"Yes\")",
            "summarizeBy": "none"
          },
          {
            "name": "Days To Ship",
            "dataType": "int64",
            "kind": "calculated",
            "isHidden": false,
            "isKey": false,
            "expression": "IF(ISBLANK(Orders[Ship Date]), BLANK(), DATEDIFF(Orders[Order Date], Orders[Ship Date], DAY))",
            "formatString": "0",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Total Sales",
            "expression": "SUM(Orders[Line Amount])",
            "formatString": "\\$#,0.00",
            "description": "Sum of the order line amounts.",
            "isHidden": false,
            "displayFolder": "Sales"
          },
          {
            "name": "Total Cost",
            "expression": "SUM(Orders[Line Cost])",
            "formatString": "\\$#,0.00",
            "isHidden": false,
            "displayFolder": "Sales"
          },
          {
            "name": "Gross Margin",
            "expression": "[Total Sales] - [Total Cost]",
            "formatString": "\\$#,0.00",
            "isHidden": false,
            "displayFolder": "Sales"
          },
          {
            "name": "Margin %",
            "expression": "DIVIDE([Gross Margin], [Total Sales])",
            "formatString": "0.0%",
            "isHidden": false,
            "displayFolder": "Sales"
          },
          {
            "name": "Sales (Scaled)",
            "expression": "[Total Sales]",
            "formatString": "\\$#,0.00",
            "description": "Total Sales with a dynamic format string: $1.23M, $45.6K or $789.00.",
            "isHidden": false,
            "displayFolder": "Sales"
          },
          {
            "name": "Completed Sales",
            "expression": "CALCULATE([Total Sales], KEEPFILTERS(Orders[Status] = \"Completed\"))",
            "formatString": "\\$#,0.00",
            "isHidden": false,
            "displayFolder": "Sales"
          },
          {
            "name": "Shipped Sales",
            "expression": "CALCULATE([Total Sales], USERELATIONSHIP(Orders[Ship Date], 'Date'[Date]))",
            "formatString": "\\$#,0.00",
            "description": "Sales by ship date (inactive relationship).",
            "isHidden": false,
            "displayFolder": "Sales"
          },
          {
            "name": "Sales All Stores",
            "expression": "CALCULATE([Total Sales], ALL(Stores))",
            "formatString": "\\$#,0.00",
            "isHidden": true,
            "displayFolder": "Sales"
          },
          {
            "name": "Store Share",
            "expression": "DIVIDE([Total Sales], [Sales All Stores])",
            "formatString": "0.0%",
            "isHidden": false,
            "displayFolder": "Sales"
          },
          {
            "name": "Order Count",
            "expression": "COUNTROWS(Orders)",
            "formatString": "#,0",
            "isHidden": false,
            "displayFolder": "Orders"
          },
          {
            "name": "Units Sold",
            "expression": "SUM(Orders[Quantity])",
            "formatString": "#,0",
            "isHidden": false,
            "displayFolder": "Orders"
          },
          {
            "name": "Active Customers",
            "expression": "DISTINCTCOUNTNOBLANK(Orders[Customer ID])",
            "formatString": "#,0",
            "description": "Distinct customer ids on orders, unknown ids included.",
            "isHidden": false,
            "displayFolder": "Orders"
          },
          {
            "name": "Avg Order Value",
            "expression": "AVERAGEX(\n    VALUES(Orders[Order ID]),\n    CALCULATE(SUM(Orders[Line Amount]))\n)",
            "formatString": "\\$#,0.00",
            "isHidden": false,
            "displayFolder": "Orders"
          },
          {
            "name": "Revenue per Unit",
            "expression": "DIVIDE(\n    SUMX(Orders, Orders[Quantity] * Orders[Unit Price] * (1 - Orders[Discount])),\n    [Units Sold]\n)",
            "formatString": "\\$#,0.00",
            "isHidden": false,
            "displayFolder": "Orders"
          },
          {
            "name": "Last Order Date",
            "expression": "MAX(Orders[Order Date])",
            "formatString": "yyyy-mm-dd",
            "isHidden": false,
            "displayFolder": "Orders"
          },
          {
            "name": "Unknown Product Orders",
            "expression": "COUNTROWS(FILTER(Orders, ISBLANK(RELATED(Products[Product Name])))) + 0",
            "formatString": "0",
            "description": "Orders whose product id is not in the catalog.",
            "isHidden": false,
            "displayFolder": "Data Quality"
          },
          {
            "name": "Sales YTD",
            "expression": "TOTALYTD([Total Sales], 'Date'[Date])",
            "formatString": "\\$#,0.00",
            "isHidden": false,
            "displayFolder": "Time Intelligence"
          },
          {
            "name": "Sales PY",
            "expression": "CALCULATE([Total Sales], SAMEPERIODLASTYEAR('Date'[Date]))",
            "formatString": "\\$#,0.00",
            "isHidden": false,
            "displayFolder": "Time Intelligence"
          },
          {
            "name": "Sales YoY %",
            "expression": "DIVIDE([Total Sales] - [Sales PY], [Sales PY])",
            "formatString": "+0.0%;-0.0%;0.0%",
            "isHidden": false,
            "displayFolder": "Time Intelligence"
          },
          {
            "name": "Sales Prev Month",
            "expression": "CALCULATE([Total Sales], DATEADD('Date'[Date], -1, MONTH))",
            "formatString": "\\$#,0.00",
            "isHidden": false,
            "displayFolder": "Time Intelligence"
          }
        ],
        "partitions": [
          {
            "name": "Orders",
            "kind": "m",
            "mode": "import",
            "expression": "let\n    Source = AzureStorage.Blobs(StorageContainerUrl),\n    #\"Source CSV\" = Csv.Document(Source{[Name = \"sales/orders.csv\"]}[Content], [Delimiter = \",\", Columns = 10, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),\n    #\"Promoted Headers\" = Table.PromoteHeaders(#\"Source CSV\", [PromoteAllScalars = true]),\n    #\"Removed Rows Without Id\" = Table.SelectRows(#\"Promoted Headers\", each Text.Trim([order_id] ?? \"\") <> \"\"),\n    #\"Cleaned Text\" = Table.TransformColumns(#\"Removed Rows Without Id\", {{\"order_id\", Text.Trim, type text}, {\"customer_id\", fnCleanKey, type text}, {\"store_id\", fnCleanKey, type text}, {\"product_id\", fnCleanKey, type text}, {\"status\", each Text.Proper(Text.Trim(_)), type text}}),\n    #\"Removed Duplicates\" = Table.Distinct(#\"Cleaned Text\"),\n    #\"Changed Type\" = Table.TransformColumnTypes(#\"Removed Duplicates\", {{\"order_date\", type date}, {\"ship_date\", type date}, {\"quantity\", Int64.Type}, {\"unit_price\", type number}, {\"discount\", type number}}),\n    #\"Default Discount\" = Table.TransformColumns(#\"Changed Type\", {{\"discount\", each _ ?? 0, type number}}),\n    #\"Added Line Amount\" = Table.AddColumn(#\"Default Discount\", \"line_amount\", each [quantity] * [unit_price] * (1 - [discount]), type number),\n    #\"Renamed Columns\" = Table.RenameColumns(#\"Added Line Amount\", {{\"order_id\", \"Order ID\"}, {\"order_date\", \"Order Date\"}, {\"ship_date\", \"Ship Date\"}, {\"customer_id\", \"Customer ID\"}, {\"store_id\", \"Store ID\"}, {\"product_id\", \"Product ID\"}, {\"quantity\", \"Quantity\"}, {\"unit_price\", \"Unit Price\"}, {\"discount\", \"Discount\"}, {\"status\", \"Status\"}, {\"line_amount\", \"Line Amount\"}})\nin\n    #\"Renamed Columns\"",
            "queryGroup": "Sources"
          }
        ],
        "hierarchies": []
      },
      {
        "name": "Customers",
        "description": "Customers (synthetic). Account managers are parsed from Python-style lists by fnParseNames.",
        "isHidden": false,
        "kind": "regular",
        "columns": [
          {
            "name": "Customer ID",
            "dataType": "string",
            "kind": "data",
            "isHidden": false,
            "isKey": true,
            "sourceColumn": "Customer ID",
            "summarizeBy": "none"
          },
          {
            "name": "Customer Name",
            "dataType": "string",
