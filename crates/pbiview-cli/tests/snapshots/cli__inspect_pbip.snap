      {
        "name": "Date",
        "description": "Calendar 2024-2025, marked as the date table.",
        "isHidden": false,
        "kind": "calculatedTable",
        "dataCategory": "Time",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "kind": "calculatedTableColumn",
            "isHidden": false,
            "isKey": true,
            "sourceColumn": "[Date]",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none"
          },
          {
            "name": "Year",
            "dataType": "int64",
            "kind": "calculatedTableColumn",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "[Year]",
            "formatString": "0",
            "summarizeBy": "none"
          },
          {
            "name": "Month Number",
            "dataType": "int64",
            "kind": "calculatedTableColumn",
            "isHidden": true,
            "isKey": false,
            "sourceColumn": "[Month Number]",
            "formatString": "0",
            "summarizeBy": "none"
          },
          {
            "name": "Month",
            "dataType": "string",
            "kind": "calculatedTableColumn",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "[Month]",
            "summarizeBy": "none",
            "sortByColumn": "Month Number"
          },
          {
            "name": "Year Month",
            "dataType": "string",
            "kind": "calculatedTableColumn",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "[Year Month]",
            "summarizeBy": "none"
          },
          {
            "name": "Quarter",
            "dataType": "string",
            "kind": "calculatedTableColumn",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "[Quarter]",
            "summarizeBy": "none"
          },
          {
            "name": "Month Start",
            "dataType": "dateTime",
            "kind": "calculatedTableColumn",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "[Month Start]",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none"
          },
          {
            "name": "Day Type",
            "dataType": "string",
            "kind": "calculated",
            "isHidden": false,
            "isKey": false,
            "expression": "IF(WEEKDAY('Date'[Date], 2) > 5, \"Weekend\", \"Weekday\")",
            "summarizeBy": "none"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Date",
            "kind": "calculated",
            "mode": "import",
            "expression": "ADDCOLUMNS(\n    CALENDAR(DATE(2024, 1, 1), DATE(2025, 12, 31)),\n    \"Year\", YEAR([Date]),\n    \"Month Number\", MONTH([Date]),\n    \"Month\", FORMAT([Date], \"mmm\"),\n    \"Year Month\", FORMAT([Date], \"yyyy-mm\"),\n    \"Quarter\", \"Q\" & QUARTER([Date]),\n    \"Month Start\", DATE(YEAR([Date]), MONTH([Date]), 1)\n)"
          }
        ],
        "hierarchies": [
