                "column": "Subcategory"
              },
              {
                "name": "Product",
                "column": "Product Name"
              }
            ]
          }
        ]
      },
      {
        "name": "Stores",
        "description": "Stores and online channels. Manager Email drives the dynamic security role.",
        "isHidden": false,
        "kind": "regular",
        "columns": [
          {
            "name": "Store ID",
            "dataType": "string",
            "kind": "data",
            "isHidden": false,
            "isKey": true,
            "sourceColumn": "Store ID",
            "summarizeBy": "none"
          },
          {
            "name": "Store Name",
            "dataType": "string",
