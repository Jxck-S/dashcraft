            "isHidden": false,
            "isKey": false,
            "sourceColumn": "Email",
            "summarizeBy": "none"
          },
          {
            "name": "Email Domain",
            "dataType": "string",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "Email Domain",
            "summarizeBy": "none"
          },
          {
            "name": "Segment",
            "dataType": "string",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "Segment",
            "summarizeBy": "none"
          },
          {
            "name": "City",
            "dataType": "string",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "City",
            "summarizeBy": "none",
            "dataCategory": "City"
          },
          {
            "name": "State",
            "dataType": "string",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "State",
            "summarizeBy": "none",
            "dataCategory": "StateOrProvince"
          },
          {
            "name": "Join Date",
            "dataType": "dateTime",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "Join Date",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none"
          },
          {
            "name": "Loyalty Tier",
            "dataType": "string",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "description": "Bronze, Silver, Gold; blanks become Unassigned.",
            "sourceColumn": "Loyalty Tier",
            "summarizeBy": "none"
          },
          {
            "name": "Account Managers",
            "dataType": "string",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "description": "Parsed names joined with \"; \"; blank when the list is empty.",
            "sourceColumn": "Account Managers",
            "summarizeBy": "none"
          },
          {
            "name": "Account Manager Count",
            "dataType": "int64",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "Account Manager Count",
            "formatString": "0",
            "summarizeBy": "none"
          },
          {
            "name": "Lifetime Sales",
            "dataType": "double",
            "kind": "calculated",
            "isHidden": false,
            "isKey": false,
            "description": "Context transition: every order of the customer, all statuses.",
            "expression": "CALCULATE(SUM(Orders[Line Amount]))",
            "formatString": "\\$#,0",
            "summarizeBy": "sum"
          },
          {
            "name": "Has Orders",
            "dataType": "string",
            "kind": "calculated",
            "isHidden": false,
            "isKey": false,
            "expression": "IF(ISEMPTY(RELATEDTABLE(Orders)), \"No\", \"Yes\")",
            "summarizeBy": "none"
          },
          {
            "name": "Value Tier",
            "dataType": "string",
            "kind": "calculated",
            "isHidden": false,
            "isKey": false,
            "expression": "SWITCH(\n    TRUE(),\n    Customers[Lifetime Sales] >= 3000, \"High\",\n    Customers[Lifetime Sales] >= 1000, \"Medium\",\n    Customers[Lifetime Sales] > 0, \"Low\",\n    \"None\"\n)",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Customer Count",
            "expression": "COUNTROWS(Customers)",
            "formatString": "#,0",
            "description": "Customers in the filter context (cross-filtered by Orders, both directions).",
            "isHidden": false
          }
        ],
        "partitions": [
          {
            "name": "Customers",
            "kind": "m",
            "mode": "import",
            "expression": "let\n    Source = AzureStorage.Blobs(StorageContainerUrl),\n    #\"Source CSV\" = Csv.Document(Source{[Name = \"sales/customers.csv\"]}[Content], [Delimiter = \",\", Columns = 10, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),\n    #\"Promoted Headers\" = Table.PromoteHeaders(#\"Source CSV\", [PromoteAllScalars = true]),\n    #\"Cleaned Text\" = Table.TransformColumns(#\"Promoted Headers\", {{\"customer_id\", fnCleanKey, type text}, {\"email\", each Text.Lower(Text.Trim(_)), type text}, {\"segment\", Text.Trim, type text}, {\"loyalty_tier\", each let t = Text.Trim(_ ?? \"\") in if t = \"\" then \"Unassigned\" else t, type text}, {\"account_managers\", each let names = fnParseNames(_ ?? \"\") in if names = \"\" then null else names, type nullable text}}),\n    #\"Removed Duplicates\" = Table.Distinct(#\"Cleaned Text\"),\n    #\"Added Name\" = Table.AddColumn(#\"Removed Duplicates\", \"customer_name\", each Text.Combine({Text.Trim([first_name]), Text.Trim([last_name])}, \" \"), type text),\n    #\"Added Domain\" = Table.AddColumn(#\"Added Name\", \"email_domain\", each Text.AfterDelimiter([email], \"@\"), type text),\n    #\"Added Manager Count\" = Table.AddColumn(#\"Added Domain\", \"manager_count\", each List.Count(List.RemoveNulls(List.Transform(Text.Split([account_managers] ?? \"\", \";\"), each if Text.Trim(_) = \"\" then null else _))), Int64.Type),\n    #\"Changed Type\" = Table.TransformColumnTypes(#\"Added Manager Count\", {{\"join_date\", type date}}),\n    #\"Selected Columns\" = Table.SelectColumns(#\"Changed Type\", {\"customer_id\", \"customer_name\", \"email\", \"email_domain\", \"segment\", \"city\", \"state\", \"join_date\", \"loyalty_tier\", \"account_managers\", \"manager_count\"}),\n    #\"Renamed Columns\" = Table.RenameColumns(#\"Selected Columns\", {{\"customer_id\", \"Customer ID\"}, {\"customer_name\", \"Customer Name\"}, {\"email\", \"Email\"}, {\"email_domain\", \"Email Domain\"}, {\"segment\", \"Segment\"}, {\"city\", \"City\"}, {\"state\", \"State\"}, {\"join_date\", \"Join Date\"}, {\"loyalty_tier\", \"Loyalty Tier\"}, {\"account_managers\", \"Account Managers\"}, {\"manager_count\", \"Account Manager Count\"}})\nin\n    #\"Renamed Columns\"",
            "queryGroup": "Sources"
          }
        ],
        "hierarchies": []
      },
      {
        "name": "Products",
        "description": "Product catalog: Category > Subcategory > Product.",
        "isHidden": false,
        "kind": "regular",
        "columns": [
          {
            "name": "Product ID",
            "dataType": "string",
            "kind": "data",
            "isHidden": false,
            "isKey": true,
            "sourceColumn": "Product ID",
            "summarizeBy": "none"
          },
          {
            "name": "Product Name",
            "dataType": "string",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "Product Name",
            "summarizeBy": "none"
          },
          {
            "name": "Category",
            "dataType": "string",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "Category",
            "summarizeBy": "none"
          },
          {
            "name": "Subcategory",
            "dataType": "string",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "Subcategory",
            "summarizeBy": "none"
          },
          {
            "name": "List Price",
            "dataType": "decimal",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "List Price",
            "formatString": "\\$#,0.00",
            "summarizeBy": "none"
          },
          {
            "name": "Unit Cost",
            "dataType": "decimal",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "Unit Cost",
            "formatString": "\\$#,0.00",
            "summarizeBy": "none"
          },
          {
            "name": "Launch Date",
            "dataType": "dateTime",
            "kind": "data",
            "isHidden": false,
            "isKey": false,
            "sourceColumn": "Launch Date",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none"
          },
          {
            "name": "Units Sold (All Time)",
            "dataType": "int64",
            "kind": "calculated",
            "isHidden": false,
            "isKey": false,
            "expression": "SUMX(RELATEDTABLE(Orders), Orders[Quantity])",
            "formatString": "#,0",
            "summarizeBy": "sum"
          },
          {
            "name": "Price Band",
            "dataType": "string",
            "kind": "calculated",
            "isHidden": false,
            "isKey": false,
            "expression": "SWITCH(\n    TRUE(),\n    Products[List Price] < 50, \"Under $50\",\n    Products[List Price] < 150, \"$50 to $149\",\n    \"$150 and up\"\n)",
            "summarizeBy": "none"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Products",
            "kind": "m",
            "mode": "import",
            "expression": "let\n    Source = AzureStorage.Blobs(StorageContainerUrl),\n    #\"Source CSV\" = Csv.Document(Source{[Name = \"catalog/products.csv\"]}[Content], [Delimiter = \",\", Columns = 7, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),\n    #\"Promoted Headers\" = Table.PromoteHeaders(#\"Source CSV\", [PromoteAllScalars = true]),\n    #\"Cleaned Text\" = Table.TransformColumns(#\"Promoted Headers\", {{\"product_id\", fnCleanKey, type text}, {\"product_name\", Text.Trim, type text}, {\"category\", Text.Trim, type text}, {\"subcategory\", Text.Trim, type text}}),\n    #\"Removed Duplicates\" = Table.Distinct(#\"Cleaned Text\"),\n    #\"Changed Type\" = Table.TransformColumnTypes(#\"Removed Duplicates\", {{\"list_price\", Currency.Type}, {\"unit_cost\", Currency.Type}, {\"launch_date\", type date}}),\n    #\"Renamed Columns\" = Table.RenameColumns(#\"Changed Type\", {{\"product_id\", \"Product ID\"}, {\"product_name\", \"Product Name\"}, {\"category\", \"Category\"}, {\"subcategory\", \"Subcategory\"}, {\"list_price\", \"List Price\"}, {\"unit_cost\", \"Unit Cost\"}, {\"launch_date\", \"Launch Date\"}})\nin\n    #\"Renamed Columns\"",
            "queryGroup": "Sources"
          }
        ],
        "hierarchies": [
