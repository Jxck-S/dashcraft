{
  "name": "dashcraft-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && npm run test",
    "test": "node --test tests/markdown.test.ts tests/editing.test.ts tests/daxEditor.test.ts tests/focus.test.ts tests/lineDiff.test.ts tests/drillthrough.test.ts tests/slicerRange.test.ts",
    "tauri": "tauri",
    "bindings": "cargo test -p dashcraft-app --lib export_bindings",
    "gen:ops": "node scripts/gen-ops.mjs --write",
    "check:ops": "node scripts/gen-ops.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
