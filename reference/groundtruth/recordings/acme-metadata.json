    {
      "id": "measures",
      "query": "EVALUATE SELECTCOLUMNS(INFO.VIEW.MEASURES(), \"Table\", [Table], \"Name\", [Name], \"IsHidden\", [IsHidden], \"DisplayFolder\", [DisplayFolder], \"Description\", [Description], \"Expression\", [Expression])",
      "columns": ["[Table]", "[Name]", "[IsHidden]", "[DisplayFolder]", "[Description]", "[Expression]"],
      "rows": [
        ["Orders", "Total Sales", false, "Sales", "Sum of the order line amounts.", "SUM(Orders[Line Amount])"],
        ["Orders", "Total Cost", false, "Sales", null, "SUM(Orders[Line Cost])"],
        ["Orders", "Gross Margin", false, "Sales", null, "[Total Sales] - [Total Cost]"],
        ["Orders", "Margin %", false, "Sales", null, "DIVIDE([Gross Margin], [Total Sales])"],
        ["Orders", "Sales (Scaled)", false, "Sales", "Total Sales with a dynamic format string: $1.23M, $45.6K or $789.00.", "[Total Sales]"],
        ["Orders", "Completed Sales", false, "Sales", null, "CALCULATE([Total Sales], KEEPFILTERS(Orders[Status] = \"Completed\"))"],
        ["Orders", "Shipped Sales", false, "Sales", "Sales by ship date (inactive relationship).", "CALCULATE([Total Sales], USERELATIONSHIP(Orders[Ship Date], 'Date'[Date]))"],
        ["Orders", "Sales All Stores", true, "Sales", null, "CALCULATE([Total Sales], ALL(Stores))"],
        ["Orders", "Store Share", false, "Sales", null, "DIVIDE([Total Sales], [Sales All Stores])"],
        ["Orders", "Order Count", false, "Orders", null, "COUNTROWS(Orders)"],
        ["Orders", "Units Sold", false, "Orders", null, "SUM(Orders[Quantity])"],
        ["Orders", "Active Customers", false, "Orders", "Distinct customer ids on orders, unknown ids included.", "DISTINCTCOUNTNOBLANK(Orders[Customer ID])"],
        ["Orders", "Avg Order Value", false, "Orders", null, "AVERAGEX(\n    VALUES(Orders[Order ID]),\n    CALCULATE(SUM(Orders[Line Amount]))\n)"],
        ["Orders", "Revenue per Unit", false, "Orders", null, "DIVIDE(\n    SUMX(Orders, Orders[Quantity] * Orders[Unit Price] * (1 - Orders[Discount])),\n    [Units Sold]\n)"],
        ["Orders", "Last Order Date", false, "Orders", null, "MAX(Orders[Order Date])"],
        ["Orders", "Unknown Product Orders", false, "Data Quality", "Orders whose product id is not in the catalog.", "COUNTROWS(FILTER(Orders, ISBLANK(RELATED(Products[Product Name])))) + 0"],
        ["Orders", "Sales YTD", false, "Time Intelligence", null, "TOTALYTD([Total Sales], 'Date'[Date])"],
        ["Orders", "Sales PY", false, "Time Intelligence", null, "CALCULATE([Total Sales], SAMEPERIODLASTYEAR('Date'[Date]))"],
        ["Orders", "Sales YoY %", false, "Time Intelligence", null, "DIVIDE([Total Sales] - [Sales PY], [Sales PY])"],
        ["Orders", "Sales Prev Month", false, "Time Intelligence", null, "CALCULATE([Total Sales], DATEADD('Date'[Date], -1, MONTH))"],
        ["Customers", "Customer Count", false, null, "Customers in the filter context (cross-filtered by Orders, both directions).", "COUNTROWS(Customers)"],
        ["Targets", "Target", false, null, null, "SUM(Targets[Target Amount])"],
        ["Targets", "Target Attainment %", false, null, null, "DIVIDE([Total Sales], [Target])"],
        ["Targets", "Target Stretch", true, null, "Gauge maximum.", "[Target] * 1.2"],
        ["Returns", "Returns Count", false, null, null, "COUNTROWS(Returns)"],
        ["Returns", "Refunds", false, null, null, "SUM(Returns[Refund Amount])"],
        ["Returns", "Return Rate", false, null, null, "DIVIDE([Returns Count], [Order Count])"],
        ["Web Sessions", "Sessions", false, null, null, "COUNTROWS('Web Sessions')"],
        ["Web Sessions", "Converted Sessions", false, null, null, "CALCULATE([Sessions], 'Web Sessions'[Converted] = TRUE())"],
        ["Web Sessions", "Conversion Rate", false, null, null, "DIVIDE([Converted Sessions], [Sessions])"],
        ["Web Sessions", "Avg Pages per Session", false, null, null, "AVERAGE('Web Sessions'[Pages Viewed])"],
        ["Web Sessions", "Sessions (All Devices)", false, null, "Ignores filters on Device.", "CALCULATE([Sessions], ALL('Web Sessions'[Device]))"],
        ["Products Never Sold", "Products Never Sold Count", false, null, null, "COUNTROWS('Products Never Sold') + 0"]
      ]
    },
